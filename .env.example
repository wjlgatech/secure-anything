# Copy to .env and fill in. NEVER commit .env.

# --- GitHub App ---
# The webhook secret you set when creating the GitHub App. Used to verify every
# incoming webhook via HMAC-SHA256. Requests with a bad/missing signature are rejected.
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string
# GitHub App credentials (for posting checks/approvals back). Optional in dev.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_API_BASE=https://api.github.com

# --- Datastore ---
# Postgres in production; SQLite is the zero-setup default for dev/tests.
DATABASE_URL=sqlite:///./agentgate.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/agentgate

# --- Queue ---
# "memory" (in-process, dev) or "redis" (scale-out workers).
QUEUE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# --- LLM risk review (optional) ---
# If unset, the LLM reviewer is skipped and the decision engine escalates on
# uncertainty rather than faking a pass ("no evidence => escalate").
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8

# --- Policy ---
POLICY_PATH=./src/agentgate/policy/default_policy.yaml

# --- App ---
LOG_LEVEL=INFO
